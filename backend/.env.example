# Postgres database connection URL (make sure pgvector extension is installed)
DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Groq Cloud API Key (for LLM summarization and live suggestion generation)
GROQ_API_KEY=your_groq_api_key_here

# Deepgram API Key (for live real-time speech-to-text streaming)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
